# EXAMPLE ONLY — copy to secret.yaml and change the password. secret.yaml is gitignored.
# kubectl create this Secret so the APIM pod does not contain a password in the Deployment YAML.
# WSO2 still boots with its built-in admin user; this Secret is the documented place for
# credentials you use with Publisher/DevPortal (default product user is admin).
apiVersion: v1
kind: Secret
metadata:
  name: wso2am-admin
  namespace: wso2
type: Opaque
stringData:
  username: admin
  # Change this after first login in a real environment. Local lab default matches WSO2 GA images.
  password: admin
